# =========================================================
# 自建影视仓 · 全局配置（集中管理，改这里即可全局生效）
# 部署后，把 PARSE_DOMAIN 换成你自己的解析服务域名
# =========================================================

# 自建解析服务域名（影视仓 plays 请求会发到这里）
# 若暂时没有自建解析，可留空，网盘源将依赖 spider.jar 内的规则
PARSE_DOMAIN="https://your-parse.example.com"

# 聚合采集接口（自建 spider 的采集入口，可选）
COLLECT_API="https://api.example.com/collect"

# 公开解析接口（用于填充 parses.url，可按需替换为可用解析站）
PUBLIC_PARSE="https://www.imooc.com/api/lib/player?url="
